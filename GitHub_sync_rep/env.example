# n8n stores credentials in its own encrypted vault, not a .env file.
# This file exists purely to stage your values before pasting them
# into n8n's credential UI (Settings > Credentials).

# ---- n8n API (used by the "Get Workflow JSON" node) ----
# Settings > n8n API > Create an API key
N8N_BASE_URL=https://your-n8n-domain.com/api/v1
N8N_API_KEY=your_n8n_api_key_here

# ---- GitHub API (used by the file sync nodes) ----
# https://github.com/settings/tokens -> Generate new token (classic) -> repo scope
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_OWNER=your-github-username
GITHUB_REPO=AI_auto
