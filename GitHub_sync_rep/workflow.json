    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst repoFolder = item.json.repoFolder;\nconst project = item.json.project;\nconst binaryKeys = Object.keys(item.binary || {});\n\nif (binaryKeys.length === 0) {\n  return [];\n}\n\nconst output = [];\nfor (const key of binaryKeys) {\n  const bin = item.binary[key];\n  const fileName = bin.fileName || key;\n  const mimeType = bin.mimeType || '';\n  let targetPath;\n  if (/^readme/i.test(fileName)) {\n    targetPath = `${repoFolder}/${fileName}`;\n  } else if (mimeType.startsWith('image/')) {\n    targetPath = `${repoFolder}/screenshots/${fileName}`;\n  } else {\n    targetPath = `${repoFolder}/${fileName}`;\n  }\n  output.push({\n    json: {\n      fileName,\n      filePath: targetPath,\n      commitMessage: `Add/update ${fileName} for ${project}`\n    },\n    binary: { file: bin }\n  });\n}\n\nreturn output;"
      },
