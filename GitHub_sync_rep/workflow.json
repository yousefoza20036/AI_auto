      "id": "445ce5d6-a9fc-48e0-b772-a737274d9c4f",
      "name": "Check File Exists1",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        80,
        480
      ],
      "webhookId": "ecc9eac8-5a17-4a22-98a2-4e59275afe2b",
      "credentials": {
        "githubApi": {
          "id": "TFFicERxcpm2Awx7",
          "name": "GitHub account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const existingBase64 = (item.json.existingContent || '').replace(/\\s/g, '');\n\n  const buffer = await this.helpers.getBinaryDataBuffer(i, 'file');\n  const uploadedBase64 = buffer.toString('base64');\n\n  if (!existingBase64 || !uploadedBase64) {\n    throw new Error(`Could not read file content for ${item.json.fileName || 'unknown file'}`);\n  }\n\n  // Same file -> skip it, no commit needed\n  if (existingBase64 === uploadedBase64) {\n    continue;\n  }\n\n  // Different -> send it to Update File\n  output.push({\n    json: {\n      filePath: item.json.filePath,\n      commitMessage: item.json.commitMessage\n    },\n    binary: { file: items[i].binary.file }\n  });\n}\n\nreturn output;"
      },
      "id": "c4399c5b-5797-474e-adc9-4a41b04832d5",
      "name": "Compare files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        272
      ]
    },
    {
      "parameters": {
        "jsCode": "const inputs = $input.all();\nconst output = [];\n\nfor (let i = 0; i < inputs.length; i++) {\n  const existing = inputs[i];\n  const uploaded = $('Split Uploaded Files').itemMatching(i);\n\n  output.push({\n    json: {\n      fileName: uploaded.json.fileName,\n      filePath: uploaded.json.filePath,\n      commitMessage: uploaded.json.commitMessage,\n      existingContent: existing.json.content || ''\n    },\n    binary: uploaded.binary\n  });\n}\n\nreturn output;"
      },
