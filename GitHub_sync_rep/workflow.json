    {
      "parameters": {
        "jsCode": "const workflowJson = $input.first().json;\nconst filePath = $('Map Project').item.json.filePath;\nconst project = $('Map Project').item.json.project;\nconst content = JSON.stringify(workflowJson, null, 2);\nconst now = new Date().toISOString();\n\nreturn [{\n  json: {\n    filePath,\n    project,\n    content,\n    commitMessage: `Sync ${project} workflow — ${now}`\n  }\n}];"
      },
