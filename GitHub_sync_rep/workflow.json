    {
      "parameters": {
        "jsCode": "const input = $input.first();\nconst project = input.json['Project'];\n\nconst map = {\n  smart_restaurant_RAG: {\n    workflowId: 'Fi9bf1rTHXqu0YTf',\n    repoFolder: 'smart_restaurant_RAG'\n  },\n  super_sec_agent_multitasker_messanger: {\n    workflowId: '6WGjiXOjDIa1yATo',\n    repoFolder: 'messenger-multiagent-assistant'\n  },\n  Customer_Lead_Processing_System: {\n    workflowId: 'VMKBvj7hpL0jvHXS',\n    repoFolder: 'Customer_Lead_Processing_System'\n  },\n  GitHub_sync_rep: {\n    workflowId: '3nIu1nPFg6H9JLfx',\n    repoFolder: 'GitHub_sync_rep'\n  }\n  \n};\n\nconst selected = map[project];\nif (!selected) {\n  throw new Error(`Unknown project selected: ${project}`);\n}\n\nconst outItem = {\n  json: {\n    project,\n    workflowId: selected.workflowId,\n    repoFolder: selected.repoFolder,\n    filePath: `${selected.repoFolder}/workflow.json`\n  }\n};\n\nif (input.binary) {\n  outItem.binary = input.binary;\n}\n\nreturn [outItem];"
      },
