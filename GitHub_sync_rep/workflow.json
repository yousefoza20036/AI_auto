      "id": "reattach_binary",
      "name": "Reattach Binary for Create",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const existing = $input.first().json;\nconst prepared = $('Prepare File Content').item.json;\n\nlet existingContent = '';\nif (existing.content) {\n  existingContent = Buffer.from(existing.content, 'base64').toString('utf-8');\n}\n\nif (existingContent.trim() === prepared.content.trim()) {\n  // No real change - skip the commit entirely\n  return [];\n}\n\nreturn [{ json: prepared }];"
      },
