    {
      "parameters": {
        "jsCode": "const inputs = $input.all();\nconst output = [];\n\nfor (let i = 0; i < inputs.length; i++) {\n  const errJson = inputs[i].json;\n  const original = $('Split Uploaded Files').itemMatching(i);\n\n  output.push({\n    json: {\n      fileName: errJson.fileName,\n      filePath: errJson.filePath,\n      commitMessage: errJson.commitMessage\n    },\n    binary: original.binary\n  });\n}\n\nreturn output;"
      },
      "id": "reattach_binary",
      "name": "Reattach Binary for Create",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        512
      ]
    },
    {
      "parameters": {
        "jsCode": "const existing = $input.first().json;\nconst prepared = $('Prepare File Content').item.json;\n\nlet existingContent = '';\nif (existing.content) {\n  existingContent = Buffer.from(existing.content, 'base64').toString('utf-8');\n}\n\nif (existingContent.trim() === prepared.content.trim()) {\n  // No real change - skip the commit entirely\n  return [];\n}\n\nreturn [{ json: prepared }];"
      },
      "id": "compare_content",
      "name": "Compare Workflow Content",
      "type": "n8n-nodes-base.code",
