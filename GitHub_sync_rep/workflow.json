    {
      "parameters": {
        "jsCode": "const errJson = $input.first().json;\nconst original = $('Split Uploaded Files').item;\n\nreturn [{\n  json: {\n    fileName: errJson.fileName,\n    filePath: errJson.filePath,\n    commitMessage: errJson.commitMessage\n  },\n  binary: original.binary\n}];"
