  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "customer-lead-processing",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "n1",
      "name": "Webhook - New Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -1200,
        432
      ],
      "webhookId": "23254509-4dd0-4740-a069-531411328f3e"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const body = item.json.body || item.json;\n\n  const name = (body.name || '').toString().trim();\n  const emailRaw = (body.email || '').toString().trim().toLowerCase();\n  const phone = (body.phone || '').toString().trim();\n  const message = (body.message || '').toString().trim();\n  const source = (body.source || 'unknown').toString().trim().toLowerCase();\n\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n  const errors = [];\n\n  if (!name) errors.push('name is required');\n  if (!emailRaw) {\n    errors.push('email is required');\n  } else if (!emailRegex.test(emailRaw)) {\n    errors.push('email is invalid');\n  }\n\n  return {\n    json: {\n      isValid: errors.length === 0,\n      validationErrors: errors,\n      name,\n      email: emailRaw,\n      phone,\n      message,\n      source,\n      receivedAt: new Date().toISOString()\n    }\n  };\n});"
      },
      "id": "n2",
      "name": "Validate & Normalize Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -960,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json.isValid}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n3",
      "name": "Is Valid Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        -720,
        304
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, error: \"Invalid lead data\", details: $json.validationErrors, receivedData: { name: $json.name, email: $json.email } } }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "n4",
      "name": "Respond - Invalid Lead",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        -480,
        464
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst highKeywords = ['urgent', 'buy', 'pricing', 'today', 'asap', 'purchase', 'quote'];\nconst mediumKeywords = ['interested', 'question', 'inquiry', 'demo', 'trial', 'info', 'information', 'details', 'schedule', 'meeting'];\n\nreturn items.map(item => {\n  const text = (item.json.message || '').toLowerCase();\n  let priority = 'LOW';\n\n  if (highKeywords.some(k => text.includes(k))) {\n    priority = 'HIGH';\n  } else if (mediumKeywords.some(k => text.includes(k))) {\n    priority = 'MEDIUM';\n  }\n\n  return {\n    json: {\n      ...item.json,\n      priority\n    }\n  };\n});"
      },
      "id": "n5",
      "name": "Determine Lead Priority",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        208
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "id": "hr1",
                    "leftValue": "={{$json.priority}}",
                    "rightValue": "HIGH",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "HIGH"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "id": "mr1",
                    "leftValue": "={{$json.priority}}",
                    "rightValue": "MEDIUM",
                    "operator": {
