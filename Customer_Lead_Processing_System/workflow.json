    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO leads (name, email, phone, message, source, priority, status, created_at)\nVALUES ('{{$json.name.replace(/'/g, \"''\")}}', '{{$json.email.replace(/'/g, \"''\")}}', '{{$json.phone.replace(/'/g, \"''\")}}', '{{$json.message.replace(/'/g, \"''\")}}', '{{$json.source.replace(/'/g, \"''\")}}', '{{$json.priority}}', '{{$json.followUpStatus}}', NOW())\nRETURNING id, name, email, priority, status;",
        "options": {}
      },
