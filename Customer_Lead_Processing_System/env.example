# ─────────────────────────────────────────────────────────────
# Customer Lead Processing System — environment reference
#
# n8n does NOT read this file directly. Credentials for the
# Slack and Postgres nodes must be created inside the n8n UI
# (Credentials → New) or via the n8n API. Use these values as
# a staging area when filling out those credential forms, and
# to configure your database and n8n instance itself.
# ─────────────────────────────────────────────────────────────

# --- n8n instance -----------------------------------------------------
# Base URL of your n8n instance (used to build the webhook URL below)
N8N_HOST=https://your-n8n-instance.example.com

# Full webhook URLs, once the workflow is Active:
#   Production: ${N8N_HOST}/webhook/customer-lead-processing
#   Test only:  ${N8N_HOST}/webhook-test/customer-lead-processing

# n8n API key (only needed if you're managing this workflow
# programmatically via the n8n public API / n8n-mcp)
N8N_API_KEY=

# --- Postgres (used by the "Store Lead in Database" node) ------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=leads_db
POSTGRES_USER=n8n_service_user
POSTGRES_PASSWORD=
# SSL is recommended for hosted Postgres (e.g. Supabase, RDS, Neon)
POSTGRES_SSL=true

# --- Slack (used by the "Send Slack Notification" node) --------------
# Bot token for a Slack app with chat:write scope
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# Channel to post HIGH priority lead alerts to (name or ID)
SLACK_CHANNEL=sales-leads
